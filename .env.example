# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- Local dev ---
SECRET_KEY=your-secret-key-here
DEBUG=True

DB_NAME=ar_restaurant
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production (Railway) ---
# These are injected automatically by Railway plugins:
#   DATABASE_URL  — from PostgreSQL plugin
#   REDIS_URL     — from Redis plugin
#
# Set these manually in Railway dashboard → Variables:
#   DJANGO_SETTINGS_MODULE = core.settings.prod
#   SECRET_KEY             = <run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
#   ALLOWED_HOSTS          = yourapp.up.railway.app
